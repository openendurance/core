{
	"$schema": "../../node_modules/turbo/schema.json",
	"extends": ["//"],
	"tags": ["core"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**", "*.tsbuildinfo"]
		},
		"build:ci": {
			"dependsOn": ["^build:ci"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**", "*.tsbuildinfo"]
		}
	}
}
