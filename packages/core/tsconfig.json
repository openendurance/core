{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"importHelpers": true,
		"lib": ["ESNext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"sourceMap": true,
		"target": "ES2022",
		"types": ["jest", "node"],
		"verbatimModuleSyntax": true
	},
	"tsc-alias": {
		"resolveFullPaths": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "**/.old", "**/.wip", "dist", "turbo", "coverage"]
}
